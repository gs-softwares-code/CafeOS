# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example.ap-south-1.aws.neon.tech/cafeos?sslmode=require"

# API & Security
PORT=4000
NODE_ENV=development
SESSION_SECRET="replace-with-a-64-char-random-hex-string"
CORS_ORIGIN="http://localhost:5173"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# Optional Google Drive Backup Export (Owner OAuth2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/backups/gdrive/callback"

# Frontend
VITE_API_URL="http://localhost:4000"

